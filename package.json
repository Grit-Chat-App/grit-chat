    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.proof",
    "e2e:android": "detox test --configuration android.emu.proof",
    "e2e:guard": "jest e2e/testids.test.js",
    "e2e:dry": "cucumber-js --dry-run",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@hop-mesh/react-native": "file:vendor/hop-mesh-react-native-bearers-c9a405c.tgz",
    "@react-native-async-storage/async-storage": "^2.2.0",
