    "@react-native-community/geolocation": "^3.4.0",
    "@react-native/assets-registry": "^0.87.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-audio-recorder-player": "^3.6.14",
    "react-native-camera-kit": "^18.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-compass": "^1.2.5",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.12.0",
    "react-native-svg": "^15.12.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@cucumber/cucumber": "11.3.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
