# Device (iphoneos) build output from the rung 2 proofs; not part of the tree
ios/build-device/

# Expanded from vendor/hop-android-maven-main-54a2e82.zip by
# scripts/fetch-android-hop-maven.sh. One committed archive, no second copy in git.
vendor/hop-android-maven/

