---
// The home page.
//
// THE GENRE, and why this page was rebuilt. It used to open with a landscape photograph and several
// hundred words of prose. The writing was good and the genre was wrong: it read as a manifesto
// rather than as an app somebody installs. whatsapp.com and telegram.org were named as the
// references, and measured at 1440x900 the shared move is not a style, it is a structure:
//
//   - The PRODUCT is the hero. WhatsApp gives its opening visual 95 percent of the viewport width
//     and inlays an app screen inside it. Telegram has no headline at all and goes straight to
//     platform tiles with device demo videos inside them.
//   - The prose is short. WhatsApp's longest single block anywhere on the page is 36 words.
//     Telegram's is 23. Ours was 220 in one section and 61 in the hero lead.
//   - One obvious call to action, as a button. WhatsApp's is 336 by 50 pixels.
//   - Features are tiles with icons, not paragraphs.
//
// So: app screens above the fold in a frame, copy cut hard, features as icon tiles, one CTA. The
// photography is NOT deleted, it is demoted from hero to supporting imagery in the sections below,
// because it is what stops this looking like every other app site.
//
// WHAT DID NOT CHANGE, and must not:
//
// THE COPY RULE THAT GOVERNS THIS FILE: nothing here may claim mesh delivery works today, because it
// does not. This build has no Bluetooth bearer and no local network bearer, so every message leaves a
// device through a relay and a relay needs internet. The headline is therefore a claim about what the
// product is FOR, never about what it currently does, and the honest status sits in the hero rather
// than buried at the bottom. A shorter page is not a quieter one: the callout moved and got tighter,
// it did not get softer. If a future build ships a radio bearer, this page changes.
//
// THE SECOND COPY RULE: Grit Chat is a CONSUMER messaging app. Its job is to be a good chat app that
// also happens to prove the network. Mine sites, search and rescue, disaster recovery and anything
// else industrial or emergency-services belongs to Hop, is sold to a different buyer, and putting it
// here makes a consumer app read like procurement collateral. So the situations named on this page
// are ones where an ordinary phone gives up: a crowd, a basement, a canyon, a campground. Hop is
// still credited and linked, because serious infrastructure underneath is the right posture. Grit
// Chat just does not sell Hop's markets.
//
// THE CALL TO ACTION IS A BETA INVITATION. There is no App Store listing, no Play listing, and
// Android has never been built. No store badges, no download chrome, nothing that implies you can
// get it today. Where the invitation goes is one value in config.ts.
//
// Feature claims are limited to what src/branding.ts and README.md say is real.

import Base from '../layouts/Base.astro';
import BrandHead from '../components/BrandHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Wordmark from '../components/Wordmark.astro';
import HopTrace from '../components/HopTrace.astro';
import Plate from '../components/Plate.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { plates } from '../assets/manifest';
import { screens, heroScreen, traceScreen } from '../assets/screens';
import { Branding } from '../branding';
import { site } from '../config';
import ogImage from '../assets/brand/og-image.png';

// Feature tiles. Icon, name, and one line. The line is the constraint: if a feature needs a
// paragraph it is not a tile, and putting a paragraph in a tile is how a tile grid becomes an essay
// with borders. Every icon is Font Awesome solid, inlined; never an emoji, whose shape belongs to
// the reader's platform rather than to this brand.
const shipped: Array<{ icon: IconName; name: string; detail: string }> = [
  { icon: 'lock', name: 'Direct messages', detail: 'One to one, sealed end to end.' },
  { icon: 'envelope-open-text', name: 'Group channels', detail: 'With invites and moderation.' },
  { icon: 'image', name: 'Photos', detail: 'Sent at a size a bad connection can carry.' },
  { icon: 'microphone', name: 'Voice notes', detail: 'Typing in a dust storm is optimistic.' },
  { icon: 'location-dot', name: 'Location', detail: 'Where you are, to people you chose.' },
  { icon: 'qrcode', name: 'QR contact swap', detail: 'You add someone by showing them a code.' },
  { icon: 'wifi', name: 'Offline history', detail: 'Readable with no signal at all.' },
  { icon: 'route', name: 'A route on every message', detail: 'The path it took to reach you.' },
];

// The real states the app draws, in the app's own vocabulary. Shape carries the state before colour
// does, so each one has its own terminal silhouette as well as its own words.
const traces = [
  { hops: 2, held: true, state: 'delivered', label: 'delivered via 2 hops', tone: 'confirmed' },
  { hops: 3, held: true, state: 'delivered', label: '3 hops to reach you', tone: 'confirmed' },
  { hops: 2, held: true, state: 'flight', label: 'carried by 2 peers, not confirmed', tone: 'moving' },
  { hops: 0, held: false, state: 'flight', label: 'accepted, nobody carrying it yet', tone: 'quiet' },
  { hops: 1, held: true, state: 'failed', label: 'not sent', tone: 'failed' },
] as const;

const hero = screens[heroScreen];
const trace = screens[traceScreen];
---

<Base
  title={Branding.displayName}
  description="A messenger for the places your phone gives up. Built on Hop, a delay tolerant mesh protocol. Relay only today, no radio yet."
  ogImage={ogImage.src}
>
  <BrandHead slot="head" />
  <Header slot="header" />

  {/* ---- hero: the product, not the landscape ---------------------------------------------
       Copy left, real app screen right, both above the fold on a laptop. The screen is the first
       thing that answers "what is this", which a photograph of a desert cannot do. */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><Wordmark height={18} decorative /> <span>{Branding.tagline}</span></p>

        <h1 id="hero-title">Built for where the network isn&rsquo;t.</h1>

        {/* 34 words. It was 61. */}
        <p class="lead">
          A messenger for the places your phone gives up. A festival where nobody has bars. A
          basement. A canyon. It runs on <a href={site.hopUrl}>Hop</a>, where a message is built to
          travel device to device instead of through a carrier.
        </p>

        <p class="actions">
          <a class="cta" href={site.betaUrl}>
            <Icon name="envelope-open-text" size={16} />
            <span>Ask for a beta invite</span>
          </a>
          <a class="cta-secondary" href="#status">See exactly where it is</a>
        </p>

        {/* The honest status, in the hero and not at the bottom. Tighter than it was, not quieter:
            30 words, a sodium rule down the side, and it sits above the fold on a laptop. */}
        <aside class="status-note" aria-label="Current status">
          <Icon name="tower-broadcast" size={16} />
          <p>
            <strong>It doesn&rsquo;t do that yet.</strong> No radio in this build, so every message
            goes through a relay and a relay needs internet. Device to device is the whole point and
            it isn&rsquo;t built.
          </p>
        </aside>

        <p class="no-store">
          Not in any app store. Closed beta, iPhone only, and Android hasn&rsquo;t been built.
        </p>
      </div>

      <div class="hero-screen">
        <DeviceFrame screen={hero} width={300} loading="eager" />
      </div>
    </div>
  </section>

  {/* ---- feature tiles ------------------------------------------------------------------- */}
  <section class="band" aria-labelledby="today-title">
    <div class="shell">
      <h2 id="today-title">What it does today</h2>
      <p class="section-lead">
        A real messenger, not a protocol demo with a chat window bolted on.
      </p>

      <ul role="list" class="features">
        {
          shipped.map((f) => (
            <li>
              <span class="tile-icon"><Icon name={f.icon} size={18} /></span>
              <h3>{f.name}</h3>
              <p>{f.detail}</p>
            </li>
          ))
        }
      </ul>

      <p class="section-note">No phone number. No account. No server that can read your messages.</p>
    </div>
  </section>

  {/* ---- the signature: every message shows its route -------------------------------------
       Kept, and kept prominent. This is the only thing in the product no other messenger can
       show, so it is the one place a longer look is earned. */}
  <section class="band alt" id="how" aria-labelledby="how-title">
    <div class="shell two-col">
      <div>
        <h2 id="how-title">Every message shows its route</h2>
        <p class="section-lead">
          A hop count is real information, so it sits under every message. These are the actual
          states, drawn the way the app draws them.
        </p>

        <ul role="list" class="trace-list">
          {
            traces.map((t) => (
              <li>
                <HopTrace hops={t.hops} held={t.held} state={t.state} label={t.label} tone={t.tone} />
              </li>
            ))
          }
        </ul>

        <div class="trace-notes">
          <p>
            Shape carries the meaning before colour does, so it survives dust, low sun and
            colourblindness. Every hop today is through a relay, not a phone reaching another phone.
          </p>
          <p>
            No other messenger can tell you this, because no other messenger has anything to tell
            you. The path was always the same server.
          </p>
        </div>
      </div>

      {/* The same trace, in the product, on a real delivery. */}
      <DeviceFrame screen={trace} width={280} />
    </div>
  </section>

  {/* ---- why it exists, with the photography doing the work it is good at -----------------
       Demoted from hero to supporting, which is the point of the restructure. The plate still
       earns its place: it is the condition the product is used in. */}
  <section class="band" aria-labelledby="who-title">
    <div class="shell two-col">
      <div class="prose">
        <h2 id="who-title">The places that break messengers</h2>
        <p>
          Every messenger you already use assumes a tower. Take the tower away and they are a list of
          conversations you cannot continue.
        </p>
        <p>
          Fifty thousand people on a dry lake bed share about as many bars as they do showers. A
          canyon wall does not care how new your phone is.
        </p>
      </div>
      <Plate
        plate={plates.camp}
        sizes="(min-width: 60rem) 26rem, 100vw"
        widths={[560, 840, 1120]}
        ratio="4 / 3"
        caption="A camp on the playa at night. Out here the only signal is whatever you brought with you."
      />
    </div>
  </section>

  {/* ---- the material, full bleed --------------------------------------------------------- */}
  <figure class="bleed">
    <Plate plate={plates.dust} sizes="100vw" widths={[768, 1152, 1536]} ratio="21 / 6" />
    <figcaption class="shell">
      Alkali dust, driven by wind. The playa is made of the stuff, which is where the name comes
      from.
    </figcaption>
  </figure>

  {/* ---- where it is --------------------------------------------------------------------- */}
  <section class="band" id="status" aria-labelledby="status-title">
    <div class="shell two-col">
      <div class="prose">
        <h2 id="status-title">Where it is, honestly</h2>
        <p><strong>There is no radio yet. That is the headline.</strong></p>
        <p>
          Nothing is discovered automatically and nothing reaches a nearby phone directly. It is not
          mesh delivery, and we are not going to call it that.
        </p>

        <h3>Proven</h3>
        <p>
          A physical iPhone reached a second, independent node through a relay, delivery confirmed
          and the hop count read off the device.
        </p>

        <h3>Not proven</h3>
        <p>
          Radio discovery. Two handsets talking to each other. Android, which has never been built.
          Channels work but need an SDK release that does not exist yet.
        </p>

        <p class="cta-row">
          <a class="cta-secondary" href={site.repoUrl}>Read the source</a>
          <a class="cta-secondary" href={`${site.repoUrl}/blob/main/PATH.md`}>See what is proven</a>
        </p>
      </div>

      <Plate
        plate={plates.relay}
        sizes="(min-width: 60rem) 26rem, 100vw"
        widths={[560, 840, 1120]}
        ratio="4 / 3"
        caption="Two people, some distance, one phone lighting a face. Today a relay still sits between them."
      />
    </div>
  </section>

  {/* ---- the landscape, demoted --------------------------------------------------------------
       This plate used to BE the hero, and it was the wrong opening: a photograph of a desert
       cannot answer "what is this app". It is still the best image in the set, so it closes the
       page instead of opening it, where atmosphere is the right job for it. */}
  <figure class="bleed">
    <Plate plate={plates.hero} sizes="100vw" widths={[768, 1152, 1376]} ratio="21 / 7" ratioNarrow="5 / 4" />
    <figcaption class="shell">
      Late dusk on the flat, and one amber light a long way off. Somebody is out there.
    </figcaption>
  </figure>

  {/* ---- closing invitation --------------------------------------------------------------- */}
  <section class="band closing" aria-labelledby="beta-title">
    <div class="shell">
      <h2 id="beta-title">Want it on your phone?</h2>
      <p class="section-lead">
        It is a closed beta on iPhone. Tell us what you have and where you would use it.
      </p>
      <p class="actions">
        <a class="cta" href={site.betaUrl}>
          <Icon name="envelope-open-text" size={16} />
          <span>Ask for a beta invite</span>
        </a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  /* ---- hero -------------------------------------------------------------------------------
     Two columns on a laptop: copy and a real app screen, both above the fold. One column on a
     phone, copy first, because the headline has to be the first thing read at 360px wide.
  */
  .hero {
    padding-block: var(--space-xxl) var(--space-xl);
    border-block-end: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-xxl);
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin: 0 0 var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--text-mono-small);
    color: var(--fg-muted);
    letter-spacing: var(--tracking-mono);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    margin: 0 0 var(--space-m);
    text-wrap: balance;
  }

  .lead {
    font-size: var(--text-lead);
    line-height: var(--leading-snug);
    color: var(--fg);
    margin: 0 0 var(--space-l);
    max-width: 34rem;
  }

  /* ---- the one obvious action -------------------------------------------------------------
     A filled sodium button, which is what sodium is for: a primary action. It is the only filled
     button on the page above the status section, so there is no competition for the eye.
  */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin: 0 0 var(--space-l);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    min-height: var(--touch-min);
    padding: 0 var(--space-l);
    border-radius: var(--radius-pill);
    background: var(--sodium);
    color: var(--sodium-deep);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-action);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
  }
  .cta:hover,
  .cta:focus-visible {
    background: var(--sodium-bright);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--sodium-bright);
    font-size: var(--text-body);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- the honest callout -----------------------------------------------------------------
     Sodium rule, not ember: this is not an error, it is the current state of a thing being built.
     Ember means failure and spending it here would make the page look broken.
  */
  .status-note {
    display: flex;
    gap: var(--space-m);
    padding: var(--space-m) var(--space-l);
    border-inline-start: 3px solid var(--sodium);
    background: var(--surface);
    border-radius: 0 var(--radius-chip) var(--radius-chip) 0;
    margin-block-end: var(--space-m);
    max-width: 36rem;
  }

  .status-note :global(.icon) {
    color: var(--sodium);
    margin-block-start: 3px;
  }

  .status-note p {
    margin: 0;
    font-size: var(--text-secondary);
    line-height: var(--leading-body);
    color: var(--fg);
  }

  .no-store {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-small);
    color: var(--fg-faint);
  }

  .hero-screen {
    display: flex;
    justify-content: center;
  }

  /* ---- bands ------------------------------------------------------------------------------ */
  .band {
    padding-block: var(--space-xxl);
    border-block-end: 1px solid var(--line);
  }

  .band.alt {
    background: var(--bg-deep);
  }

  .band h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    margin: 0 0 var(--space-s);
  }

  .section-lead {
    font-size: var(--text-lead);
    color: var(--fg-muted);
    margin: 0 0 var(--space-xl);
    max-width: 38rem;
  }

  .section-note {
    margin: var(--space-xl) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-small);
    color: var(--fg-faint);
  }

  /* ---- feature tiles ---------------------------------------------------------------------
     Icon, name, one line. Three up on a laptop, two on a tablet, one on a phone.
  */
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
  }

  @media (min-width: 34rem) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .features {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .features li {
    padding: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
  }

  .tile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-chip);
    background: var(--raised);
    /* Sodium is the action colour and sage means delivered, so a tile icon gets neither. Dust is
       the right register: present, legible, and not claiming anything. */
    color: var(--dust);
    margin-block-end: var(--space-m);
  }

  .features h3 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-title);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-xxs);
  }

  .features p {
    margin: 0;
    font-size: var(--text-secondary);
    color: var(--fg-muted);
    line-height: var(--leading-body);
  }

  /* ---- trace list ------------------------------------------------------------------------ */
  .trace-list {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: var(--space-l);
    display: grid;
    gap: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-chip);
    max-width: 34rem;
  }

  .trace-notes {
    display: grid;
    gap: var(--space-m);
    max-width: 38rem;
  }

  .trace-notes p {
    margin: 0;
    font-size: var(--text-secondary);
    color: var(--fg-muted);
    line-height: var(--leading-body);
  }

  /* ---- two column prose plus plate ------------------------------------------------------- */
  .two-col {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .two-col {
      grid-template-columns: minmax(0, 1fr) 26rem;
      gap: var(--space-xxl);
    }
  }

  .prose p {
    margin: 0 0 var(--space-m);
    line-height: var(--leading-body);
    max-width: 34rem;
  }

  .prose h3 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-title);
    margin: var(--space-l) 0 var(--space-xs);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-block-start: var(--space-l);
  }

  /* ---- full bleed plate ------------------------------------------------------------------ */
  .bleed {
    margin: 0;
    border-block-end: 1px solid var(--line);
  }

  .bleed :global(img) {
    border-radius: 0;
    outline: none;
  }

  .bleed figcaption {
    padding-block: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--text-mono-small);
    color: var(--fg-faint);
  }

  /* ---- closing ---------------------------------------------------------------------------- */
  .closing {
    border-block-end: 0;
    text-align: center;
  }

  .closing .section-lead {
    margin-inline: auto;
  }

  .closing .actions {
    justify-content: center;
    margin-block-end: 0;
  }
</style>
